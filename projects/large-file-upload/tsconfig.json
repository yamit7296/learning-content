{
  "compilerOptions": {
    "target": "ES6",                      // Target ES6+ (or ESNext)
    "module": "CommonJS",                  // CommonJS for Node.js
    "strict": true,                        // Enable strict type checking
    "esModuleInterop": true,               // Allow import/export interop
    "skipLibCheck": true,                  // Skip type checking of all declaration files (.d.ts)
    "forceConsistentCasingInFileNames": true, // Ensure consistent casing in imports
    "outDir": "./dist",                    // Output directory for compiled files
    "rootDir": "./src",                    // Source directory
    "moduleResolution": "node"             // Node.js resolution for modules
  },
  "include": ["src"],                      // Include the src folder for TypeScript files
  "exclude": ["node_modules"]              // Exclude node_modules from compilation
}
